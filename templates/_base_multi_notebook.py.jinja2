# Databricks notebook source
# MAGIC %md
# MAGIC ## Auto-generated multi-file ingestion notebook
# MAGIC **Source:** {{ source_type }} files under `{{ source_path }}`
# MAGIC **Tables:** {{ tables | map(attribute='table') | join(', ') }}
# MAGIC **Generated by:** ingestion codegen prototype — schema captured at generation time, not re-inferred on every run. One job ingests every table above, sequentially, in this single notebook.

# COMMAND ----------

from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType, StructField,
    {{ spark_type_imports }}
)
import uuid

# COMMAND ----------

# Parameters — set by the Databricks Job's base_parameters at deploy time
# (see deploy_cli.py / databricks_deploy.py), falling back to this default
# if run interactively without a job. One folder path covers every table
# below — each table's filename (captured at generation time) is joined
# onto it at run time, so redeploying against a different folder doesn't
# require regenerating the notebook.
dbutils.widgets.text("source_path", "{{ source_path }}")
dbutils.widgets.text("batch_id", str(uuid.uuid4()))

source_folder = dbutils.widgets.get("source_path").rstrip("/")
batch_id = dbutils.widgets.get("batch_id")
{% for t in tables %}
# COMMAND ----------

# MAGIC %md
# MAGIC ### Table: `{{ t.table }}` — from `{{ t.file_name }}`

# COMMAND ----------

# Schema captured from the source sample at generation time.
# Deliberately NOT using inferSchema at read time — a fixed schema keeps
# every run deterministic instead of silently reinterpreting types if a
# later file looks slightly different.
schema = StructType([
{% for col in t.columns %}
    StructField("{{ col.name }}", {{ col.spark_type }}(), {{ col.nullable }}),
{% endfor %}
])

source_path = f"{source_folder}/{{ t.file_name }}"

# COMMAND ----------

{% block read_source %}{% endblock %}

# COMMAND ----------

# Standard lineage columns — every generated pipeline adds these, per PRD Section 5.5
df = (
    df
    .withColumn("_ingested_at", F.current_timestamp())
    .withColumn("_source_file", F.col("_metadata.file_path"))
    .withColumn("_batch_id", F.lit(batch_id))
)

target_table = "{{ catalog }}.{{ target_schema }}.{{ t.table }}"

spark.sql(f"""
CREATE TABLE IF NOT EXISTS {target_table} (
{% for col in t.columns %}
    {{ col.name }} {{ col.sql_type }},
{% endfor %}
    _ingested_at TIMESTAMP,
    _source_file STRING,
    _batch_id STRING
)
USING DELTA
""")

df.write.mode("append").saveAsTable(target_table)

print(f"Ingested {df.count()} rows into {target_table} (batch_id={batch_id})")
{% endfor %}
# COMMAND ----------

print("Multi-file ingestion job complete.")
