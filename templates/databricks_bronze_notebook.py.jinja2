# COMMAND ----------

# Schema captured from the source sample at generation time.
# Deliberately NOT using inferSchema at read time — a fixed schema keeps
# every run deterministic instead of silently reinterpreting types if a
# later file looks slightly different.
schema = StructType([
{% for col in columns %}
    StructField("{{ col.name }}", {{ col.spark_type }}(), {{ col.nullable }}),
{% endfor %}
])

# COMMAND ----------

df = (
    spark.read
    .option("header", "{{ has_header }}")
    .option("delimiter", "{{ delimiter }}")
    .schema(schema)
    .csv(source_path)
)

# COMMAND ----------

# Standard lineage columns — every generated pipeline adds these, per PRD Section 5.5
df = (
    df
    .withColumn("_ingested_at", F.current_timestamp())
    .withColumn("_source_file", F.col("_metadata.file_path"))
    .withColumn("_batch_id", F.lit(batch_id))
)

# COMMAND ----------

target_table = "{{ catalog }}.{{ target_schema }}.{{ table }}"

spark.sql(f"""
CREATE TABLE IF NOT EXISTS {target_table} (
{{ ddl_columns }}
    _ingested_at TIMESTAMP,
    _source_file STRING,
    _batch_id STRING
)
USING DELTA
""")

df.write.mode("append").saveAsTable(target_table)

# COMMAND ----------

print(f"Ingested {df.count()} rows into {target_table} (batch_id={batch_id})")
