# Copy to .env to override the local-dev defaults in docker-compose.yml.
# (.env is gitignored; this example file is what gets committed.)
POSTGRES_USER=ingestion_saas
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=ingestion_saas
POSTGRES_PORT=5432
ADMINER_PORT=8080
BACKEND_PORT=8000
# Signs login tokens. Any long random string; must be a real secret anywhere but local dev.
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789
# Encrypts the Databricks tokens stored per organization (a Fernet key). The default in
# docker-compose.yml is a well-known dev key — fine locally, refused when ENVIRONMENT is not dev.
# Generate a real one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes stored tokens unreadable (admins would re-enter them).
CREDENTIAL_ENCRYPTION_KEY=
# How long a login token lasts, in minutes. Local default is 480 (8h); the app itself defaults to 60.
JWT_EXPIRE_MINUTES=480
FRONTEND_PORT=5173
# Extra browser origins allowed to call the API, beyond http://localhost:5173 (comma-separated).
# Needed if you run the frontend somewhere else (a different port, a deployed URL, etc.).
CORS_EXTRA_ORIGINS=
